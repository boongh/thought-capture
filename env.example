# Thought Capture AI - local configuration template.
#
# Copy this file to `.env` in the repository root and fill it in:
#     cp env.example .env
#
# `.env` is gitignored and must never be committed. Do not paste real tokens
# into chat, issues, logs, screenshots, or commit messages (docs/DESIGN.md 12.2).
#
# Compose resolves a bare `.env` relative to the compose file rather than the
# repository root, so always pass it explicitly:
#     docker compose --env-file .env -f deploy/compose/docker-compose.yml \
#       --profile core up -d
#
# Optional settings may be left blank; a blank value is read as unset.

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
TC_WORKSPACE_NAME=personal
# IANA timezone name. Drives the daily cutoff (docs/DESIGN.md 4.2).
TC_WORKSPACE_TIMEZONE=Asia/Bangkok
# Local wall-clock time of the daily digest cutoff, HH:MM.
TC_DIGEST_LOCAL_TIME=20:00

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Application role. Denied UPDATE/DELETE on `thoughts` (append-only invariant).
TC_DATABASE_URL=postgresql+psycopg://tc_app:CHANGE_ME@127.0.0.1:5432/thought_capture
# Migration role. Owns the schema; used only by the one-shot migrate step.
TC_MIGRATION_DATABASE_URL=postgresql+psycopg://tc_migrator:CHANGE_ME@127.0.0.1:5432/thought_capture
TC_DATABASE_POOL_SIZE=5

# Consumed by docker compose to provision the container on first boot.
POSTGRES_DB=thought_capture
POSTGRES_USER=tc_migrator
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
# Password for the least-privilege application role, created by migration 0001.
TC_APP_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from the Discord developer portal. Requires the privileged
# MESSAGE_CONTENT intent (docs/DESIGN.md 4.1).
TC_DISCORD_BOT_TOKEN=
# Snowflake ID of the only user permitted to capture.
TC_DISCORD_OWNER_USER_ID=
# Optional: restrict capture to one guild and channel. Leave blank for DM-only.
TC_DISCORD_GUILD_ID=
TC_DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
TC_OPENROUTER_API_KEY=
TC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# safe (default): model_organize/model_query_plan must be a slug in
#   tc_infrastructure.llm.reviewed_models.REVIEWED_MODELS - reviewed for
#   provider retention/training policy and confirmed to support strict
#   JSON-schema output (docs/adr/0006).
# custom: pin any slug. You are accepting responsibility for that model's
#   privacy and schema-enforcement behavior yourself.
TC_MODEL_SELECTION_MODE=safe

# Pinned model slugs. Never use floating "latest" aliases (docs/DESIGN.md 11).
#
#   Reviewed (safe mode): none yet. qwen/qwen3.8-flash was staged here during
#                 initial setup but removed on 2026-09-01: its only OpenRouter
#                 endpoint (Alibaba) is not on OpenRouter's zero-data-retention
#                 endpoint list, and Alibaba's raw API-traffic retention policy
#                 was never independently confirmed - see REVIEWED_MODELS and
#                 docs/adr/0006. Leaving both fields blank in safe mode (the
#                 default) runs organize/query-plan on the deterministic
#                 offline adapter until a model passes review.
#   Custom mode only:  nvidia/nemotron-3.5-lightning:free
#                 $0/month, but OpenRouter free endpoints require enabling
#                 account-wide "may train on inputs" / "may publish prompts",
#                 and the model does not support `response_format` at all -
#                 fails both the privacy and schema-enforcement bar for safe mode.
TC_MODEL_ORGANIZE=
TC_MODEL_QUERY_PLAN=
# Set true only if the pinned model verifiably supports json_schema + strict.
TC_MODEL_SUPPORTS_STRICT_SCHEMA=false
# Only consulted in custom mode. Safe mode never allows OpenRouter to route to
# a different provider than the one vetted for a pinned reviewed model, or to
# a provider that may retain/train on the request, regardless of this value.
TC_MODEL_ALLOW_FALLBACK=true
# Only consulted in custom mode. Safe mode always restricts routing to
# OpenRouter's confirmed zero-data-retention endpoints (`provider.zdr`),
# regardless of this value. TC_MODEL_ALLOW_FALLBACK controls provider
# failover, not this retention constraint.
TC_MODEL_REQUIRE_ZDR=false
# Alert threshold in USD per calendar month.
TC_MONTHLY_BUDGET_USD=5.00

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
TC_ATTACHMENT_ROOT=./attachments
TC_ATTACHMENT_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
TC_API_HOST=127.0.0.1
TC_API_PORT=8080
# Local bearer token for non-Discord access. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TC_API_BEARER_TOKEN=
