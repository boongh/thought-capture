# Thought Capture AI - local configuration template.
#
# Copy this file to `.env` in the repository root and fill it in:
#     cp env.example .env
#
# `.env` is gitignored and must never be committed. Do not paste real tokens
# into chat, issues, logs, screenshots, or commit messages (docs/DESIGN.md 12.2).
#
# Compose resolves a bare `.env` relative to the compose file rather than the
# repository root, so always pass it explicitly:
#     docker compose --env-file .env -f deploy/compose/docker-compose.yml \
#       --profile core up -d --build
#
# Optional settings may be left blank; a blank value is read as unset.

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
TC_WORKSPACE_NAME=personal
# IANA timezone name. Drives the daily cutoff (docs/DESIGN.md 4.2).
TC_WORKSPACE_TIMEZONE=Asia/Bangkok
# Local wall-clock time of the daily digest cutoff, HH:MM.
TC_DIGEST_LOCAL_TIME=20:00
# Organize context assembly (docs/DESIGN.md 7.3.6). At most this many existing
# documents get their full body sent to the organize prompt per run.
TC_CONTEXT_MAX_SELECTED_DOCUMENTS=12
# An entity mentioned within this many days is included by the recency signal.
TC_CONTEXT_RECENCY_DAYS=3.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Compose uses each password both literally for role provisioning and inside a
# database URL. The current stack therefore supports ASCII letters/digits only.
# Application role. Provisioned by the PostgreSQL init script and denied
# UPDATE/DELETE on `thoughts` by migrations (append-only invariant).
TC_DATABASE_URL=postgresql+psycopg://tc_app:CHANGE_ME@127.0.0.1:5432/thought_capture
# Migration role. Owns the schema; used only by the one-shot migrate step.
TC_MIGRATION_DATABASE_URL=postgresql+psycopg://tc_migrator:CHANGE_ME@127.0.0.1:5432/thought_capture
TC_DATABASE_POOL_SIZE=5

# Consumed by docker compose to provision the container on first boot.
POSTGRES_DB=thought_capture
POSTGRES_USER=tc_migrator
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
# Password for the least-privilege application role, created by the init script.
TC_APP_DB_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from the Discord developer portal. Requires the privileged
# MESSAGE_CONTENT intent (docs/DESIGN.md 4.1).
TC_DISCORD_BOT_TOKEN=
# Snowflake ID of the only user permitted to capture.
TC_DISCORD_OWNER_USER_ID=
# Optional: restrict capture to one guild and channel. Leave blank for DM-only.
TC_DISCORD_GUILD_ID=
TC_DISCORD_CHANNEL_ID=

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
TC_OPENROUTER_API_KEY=
TC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# safe (default): model_organize/model_select/model_query_plan must each be a
#   slug in tc_infrastructure.llm.reviewed_models.REVIEWED_MODELS - reviewed
#   for provider retention/training policy and confirmed to support strict
#   JSON-schema output (docs/adr/0006).
# custom: pin any slug. You are accepting responsibility for that model's
#   privacy and schema-enforcement behavior yourself.
TC_MODEL_SELECTION_MODE=safe

# Pinned model slugs. Never use floating "latest" aliases (docs/DESIGN.md 11).
#
#   Reviewed (safe mode): upstage/solar-pro4, for select only, and
#                 x-ai/grok-4.3, for organize only - see REVIEWED_MODELS and
#                 docs/model-evaluation-organize-select.md for the evaluation
#                 evidence (13 rounds for organize; grok-4.3 is the only
#                 candidate to pass every probe across an N=5 confirmation,
#                 and remained unbeaten after round 13's broad search for a
#                 cheaper reasoning-model alternative). qwen/qwen3.8-flash
#                 was staged here during initial setup but removed on
#                 2026-09-01 (its only OpenRouter endpoint, Alibaba, is not
#                 on OpenRouter's zero-data-retention endpoint list); an
#                 earlier organize candidate (meta-llama/llama-4-maverick)
#                 surfaced a reproducible output defect under higher-N
#                 testing and was not added. Leaving TC_MODEL_ORGANIZE blank
#                 (the default) runs organize on the deterministic offline
#                 adapter regardless of selection mode - set it to
#                 x-ai/grok-4.3 to enable live organize calls;
#                 reasoning_effort="none" is applied automatically from the
#                 registry (Settings.reasoning_effort_for), not a separate
#                 setting - see round 8's finding that this is close to a
#                 requirement, not an optional optimization, for this
#                 candidate's cost to fit TC's operational budget.
#   Custom mode only:  nvidia/nemotron-3.5-lightning:free
#                 $0/month, but OpenRouter free endpoints require enabling
#                 account-wide "may train on inputs" / "may publish prompts",
#                 and the model does not support `response_format` at all -
#                 fails both the privacy and schema-enforcement bar for safe mode.
TC_MODEL_ORGANIZE=
TC_MODEL_SELECT=
TC_MODEL_QUERY_PLAN=
# Set true only if the pinned model verifiably supports json_schema + strict.
TC_MODEL_SUPPORTS_STRICT_SCHEMA=false
TC_MODEL_SELECT_SUPPORTS_STRICT_SCHEMA=false
# Only consulted in custom mode. Safe mode never allows OpenRouter to route to
# a different provider than the one vetted for a pinned reviewed model, or to
# a provider that may retain/train on the request, regardless of this value.
TC_MODEL_ALLOW_FALLBACK=true
# Only consulted in custom mode. Safe mode always restricts routing to
# OpenRouter's confirmed zero-data-retention endpoints (`provider.zdr`),
# regardless of this value. TC_MODEL_ALLOW_FALLBACK controls provider
# failover, not this retention constraint.
TC_MODEL_REQUIRE_ZDR=false
# Alert threshold in USD per calendar month.
TC_MONTHLY_BUDGET_USD=5.00

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
TC_ATTACHMENT_ROOT=./attachments
TC_ATTACHMENT_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
TC_API_HOST=127.0.0.1
TC_API_PORT=8080
# Local bearer token for non-Discord access. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TC_API_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Embedding sidecar (docs/adr/0010) - `--profile core`. First-party, local,
# no external credential: unlike Khoj below this is not optional and needs
# no secrets of its own.
# ---------------------------------------------------------------------------
# A normal `--profile core up` does NOT publish this to any host port at
# all - unlike postgres/api above, this service has no authentication of
# its own, so it is reachable only from other containers on the compose
# network (http://embedding-sidecar:8081) day to day. TC_EMBEDDING_SIDECAR_PORT
# only takes effect when scripts/check.*/CI additionally apply
# deploy/compose/embedding-sidecar.contract-test.docker-compose.yml, which
# publishes it to loopback for exactly as long as its own contract tests
# need to reach it from the host.
TC_EMBEDDING_SIDECAR_PORT=8081
TC_EMBEDDING_SIDECAR_BASE_URL=http://127.0.0.1:8081
# Container-level resource ceiling, alongside the request-level batch/length/
# concurrency bounds the sidecar enforces itself (defense in depth against a
# CPU-bound process handling unauthenticated-within-the-network requests).
TC_EMBEDDING_SIDECAR_MEM_LIMIT=2g
TC_EMBEDDING_SIDECAR_CPU_LIMIT=2.0

# ---------------------------------------------------------------------------
# Khoj (docs/adr/0003) - `--profile ai`. These services live in a SEPARATE
# compose file, deploy/compose/khoj.docker-compose.yml, passed with a second
# `-f`; only that file's services actually read these variables, so leaving
# them unset does not affect a Khoj-less `--profile core` startup.
# ---------------------------------------------------------------------------
# Khoj's own PostgreSQL, a separate container/database from the one above
# (docs/adr/0003) - not consumed by any first-party service.
TC_KHOJ_DB_PASSWORD=CHANGE_ME
# Django's SECRET_KEY, used for session/CSRF signing inside Khoj only.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
TC_KHOJ_DJANGO_SECRET_KEY=CHANGE_ME
# Khoj's own Django admin panel at /server/admin - not this project's auth
# boundary (the port is loopback-only and run with --anonymous-mode) and not
# read by any adapter here. Still required by the image to boot.
TC_KHOJ_ADMIN_EMAIL=admin@localhost
TC_KHOJ_ADMIN_PASSWORD=CHANGE_ME
TC_KHOJ_PORT=42110
TC_KHOJ_BASE_URL=http://127.0.0.1:42110

# Khoj's OWN chat-model credentials (docs/adr/0003 finding 4 and its "Ask
# proxy" amendment). Blank by default: Khoj boots with no chat model
# configured, and `/ask` reports that explicitly instead of guessing.
# Setting these two makes Khoj's own first-boot --non-interactive setup
# auto-register an OpenAI-compatible chat model - this can point at a local
# server (e.g. Ollama's http://host.docker.internal:11434/v1/) or at
# OpenRouter using the same safe-mode reviewed-model/ZDR discipline
# docs/adr/0006 already established for this project's own organize/select
# calls. Either way, this is entirely the operator's own choice: no code in
# this project ever sets or reads these two variables itself.
TC_KHOJ_OPENAI_BASE_URL=
TC_KHOJ_OPENAI_API_KEY=

# This project's OWN gate on Ask, independent of the two variables above.
# All three must be true before a question ever reaches a live model: Khoj
# must have a chat model configured (above), this must be true, AND you must
# set the acknowledgment below. Leaving any at its default keeps Ask
# reporting "not enabled" instead of silently answering from an unreviewed
# model.
TC_ASK_ENABLED=false
# A required, separate acknowledgment (docs/adr/0003's "Ask proxy" amendment,
# "Provider acknowledgment"): this project's code has no hook into Khoj's own
# outbound request to whichever chat model it is configured with, so it
# cannot enforce a reviewed-provider/ZDR policy on that route the way
# docs/adr/0006 does for this project's own OpenRouter calls. Setting
# TC_ASK_ENABLED=true without also setting this to true refuses to start
# (fail-fast, matching safe mode's own reviewed-model check) - set this only
# after you have personally reviewed the retention/training policy of
# whichever model TC_KHOJ_OPENAI_BASE_URL points at.
TC_ASK_PROVIDER_RETENTION_ACKNOWLEDGED=false
